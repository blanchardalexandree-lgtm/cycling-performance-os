# Base PostgreSQL 16+
DATABASE_URL="postgresql://cpos:cpos@localhost:5432/cpos?schema=public"
# URL publique de l'application (sert aux redirections OAuth et à la vérification d'origine)
APP_URL="http://localhost:3000"
# 32 octets en base64, obligatoire : openssl rand -base64 32
# Chiffre les tokens Strava/Garmin (AES-256-GCM). Ne jamais la changer sans reconnecter les comptes.
TOKEN_ENCRYPTION_KEY=""
# "false" = inscriptions fermées dès qu'un compte existe
ALLOW_REGISTRATION="true"

# Strava (https://www.strava.com/settings/api) — abonnement Strava requis pour créer une app
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Chaîne aléatoire choisie par toi, utilisée à la création de l'abonnement webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=""
# Renvoyé par Strava à la création de l'abonnement webhook (filtre les événements)
STRAVA_SUBSCRIPTION_ID=""

# Coach IA — sans clé, l'application fonctionne en « mode démonstration » clairement signalé
ANTHROPIC_API_KEY=""
COACH_MODEL="claude-opus-5-5"

# Compte créé par `npm run db:seed`
SEED_EMAIL=""
SEED_PASSWORD=""
SEED_NAME="Alexandre"
